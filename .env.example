# Target environment: mock | qa | staging | prod (prod runs read-only smoke only)
TEST_ENV=mock

# Marketplace front-end and API base URLs
BASE_URL=http://localhost:4010
API_BASE_URL=http://localhost:4010

# Role accounts (one per role, used by SQ-055 and all role-specific flows)
ADMIN_EMAIL=admin@uvation.test
ADMIN_PASSWORD=change-me
SALES_EMAIL=sales@uvation.test
SALES_PASSWORD=change-me
APPROVER_EMAIL=approver@uvation.test
APPROVER_PASSWORD=change-me
FINANCE_EMAIL=finance@uvation.test
FINANCE_PASSWORD=change-me
CUSTOMER_EMAIL=buyer@acme-ai.test
CUSTOMER_PASSWORD=change-me
# A second customer belonging to a different company (SQ-056 cross-customer access)
OTHER_CUSTOMER_EMAIL=buyer@globex.test
OTHER_CUSTOMER_PASSWORD=change-me

# Mail catcher (Mailpit/MailHog-compatible API) used to verify quote emails
MAIL_API_URL=http://localhost:4010/mailpit

# Fault-injection hooks (email outage, pricing latency, service restart).
# Only enable on environments that expose the /__test hooks.
FAULT_INJECTION=true

# Test data file (SKUs, price lists, discount codes) per environment
TEST_DATA_FILE=test-data/mock.json

# NFR load parameters
NFR_CONCURRENCY=25
NFR_P95_MS=2000
