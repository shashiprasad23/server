{
  "name": "uvation-marketplace-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Automation pipeline for the Uvation Marketplace quote (Send Quote) workflow: functional, security and non-functional suites.",
  "scripts": {
    "mock": "tsx mock-server/server.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:p0": "playwright test --grep @P0",
    "test:regression": "playwright test --project=api --project=ui",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:nfr": "playwright test --project=nfr",
    "report": "playwright show-report reports/html",
    "perf:k6": "k6 run perf/k6/quote-load.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
