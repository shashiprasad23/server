# Runtime connection (non-superuser role so row-level security is enforced)
DATABASE_URL=postgres://atlas_app:atlas_app@localhost:5432/atlas_dev
# Owner connection used only for migrations and seeding
MIGRATION_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_dev
APP_DB_ROLE=atlas_app
PORT=3000

# Auth: HS256 bearer tokens for now; swap to Entra ID OIDC (AUTH_MODE=oidc) when SSO is wired
JWT_SECRET=change-me-in-every-environment
AUTH_DEV_TOKENS=true

# Single-tenant default for inbound webhooks (seeded Uvation tenant)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# HMAC secrets per inbound source (header: X-Atlas-Signature: sha256=<hex of HMAC(body)>)
CHANNEL_SECRET_MARKETPLACE=dev-marketplace-secret
CHANNEL_SECRET_USP=dev-usp-secret
CHANNEL_SECRET_OUTLOOK=dev-outlook-secret
CHANNEL_SECRET_TEAMS=dev-teams-secret
CHANNEL_SECRET_WHATSAPP=dev-whatsapp-secret

# LLM gateway: "anthropic" uses Claude via the Anthropic SDK; "heuristic" runs offline rules
LLM_PROVIDER=heuristic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Background workers (outbox dispatcher, outbound sender, approval expiry)
WORKERS_ENABLED=true
OUTBOUND_UNDO_WINDOW_SECONDS=120
