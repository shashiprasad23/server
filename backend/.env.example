# Copy to backend/.env for local overrides. In Azure, supply these from Key Vault / app settings.
UPM_DATABASE_URL=postgresql+psycopg://upm:upm@localhost:5432/upm
UPM_ENVIRONMENT=development

# Identity: "dev" offers persona sign-in for local use; production must use "oidc" (Microsoft Entra ID).
UPM_AUTH_MODE=dev
# UPM_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# UPM_OIDC_AUDIENCE=api://<app-registration-client-id>
# UPM_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# UPM_OIDC_SUBJECT_CLAIM=oid
UPM_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
UPM_WEBHOOK_SECRET=dev-webhook-secret

# Background processing: run the worker inside the API process (dev) or separately (`python -m app.worker`).
UPM_RUN_WORKER_IN_PROCESS=true

# AI meeting intelligence: "heuristic" is fully local and deterministic; "ollama" uses a local LLM runtime.
UPM_AI_PROVIDER=heuristic
# UPM_OLLAMA_URL=http://localhost:11434
# UPM_OLLAMA_MODEL=llama3.1:8b

# Microsoft Teams transcript import (application permission OnlineMeetingTranscript.Read.All + access policy)
# UPM_GRAPH_TENANT_ID=
# UPM_GRAPH_CLIENT_ID=
# UPM_GRAPH_CLIENT_SECRET=
# Optional Teams channel delivery for notifications (title + deep link only)
# UPM_TEAMS_WEBHOOK_URL=
